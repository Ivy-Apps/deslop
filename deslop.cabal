cabal-version:   3.0
name:            deslop
version:         0.4.10
license:         BSD-3-Clause
license-file:    LICENSE
author:          Ivy Apps LTD
maintainer:      iliyan@ivy-apps.com
build-type:      Simple
extra-doc-files: CHANGELOG.md

common shared-properties
  default-language:   GHC2024
  ghc-options:        -Wall -Werror
  default-extensions:
    DataKinds
    DeriveAnyClass
    DeriveGeneric
    DerivingStrategies
    DuplicateRecordFields
    LambdaCase
    NoFieldSelectors
    OverloadedLabels
    OverloadedRecordDot
    OverloadedStrings
    TypeApplications
    TypeFamilies

  mixins:             base hiding (Prelude)
  build-depends:
    , base
    , relude

executable deslop
  import:          shared-properties
  main-is:         Main.hs
  autogen-modules: Paths_deslop
  other-modules:   Paths_deslop
  build-depends:
    , deslop
    , optparse-applicative

  hs-source-dirs:  app

library
  import:          shared-properties
  exposed-modules:
    Deslop
    Deslop.AST
    Deslop.RelativeImports
    Deslop.RuleBook
    Effects.AI
    Effects.CLILog
    Effects.FileSystem
    Effects.Git
    Effects.ReportProblem
    FsEncoding
    Params
    Prelude
    Secrets
    Types
    TypeScript.Config
    TypeScript.CST
    TypeScript.Lexer
    TypeScript.Parser
    TypeScript.Tokens
    UI
    Utils

  autogen-modules: Paths_deslop
  other-modules:   Paths_deslop
  build-depends:
    , aeson
    , aeson-pretty
    , ansi-terminal
    , attoparsec
    , attoparsec-aeson
    , bytestring
    , containers
    , directory             >=1.3.8.0
    , effectful
    , effectful-core
    , extra
    , file-io
    , filepath              >=1.4.100.0
    , fmt
    , Glob
    , lens
    , megaparsec
    , optparse-applicative
    , ordered-containers
    , os-string
    , process
    , req
    , stm
    , template-haskell
    , text
    , time
    , unordered-containers
    , yaml

  hs-source-dirs:  src

test-suite deslop-test
  import:             shared-properties
  default-extensions:
    QuasiQuotes
    TemplateHaskell

  type:               exitcode-stdio-1.0
  hs-source-dirs:     test
  main-is:            Spec.hs
  build-tool-depends: hspec-discover:hspec-discover
  other-modules:
    Deslop.ASTSpec
    Deslop.RelativeImportSpec
    Deslop.RuleBookFixtures
    Deslop.RuleBookSpec
    E2E.FileGoldenSpec
    E2E.ProjectGoldenSpec
    Effects.ReportProblemSpec
    ParamsSpec
    SecretsSpec
    TestUtils
    TypeScript.ConfigSpec
    TypeScript.LexerSpec
    TypeScript.ParserSpec
    TypeScript.RenderableSpec

  build-depends:
    , aeson
    , aeson-pretty
    , bytestring
    , containers
    , deslop
    , directory             >=1.3.8.0
    , effectful
    , file-io
    , filepath              >=1.4.100.0
    , Glob
    , hedgehog
    , hspec
    , hspec-golden
    , hspec-hedgehog
    , lens
    , megaparsec
    , optparse-applicative
    , os-string
    , pretty-show
    , template-haskell
    , text
    , unliftio
    , yaml
