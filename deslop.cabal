cabal-version:   3.0
name:            deslop
version:         0.7.1
license:         BSD-3-Clause
license-file:    LICENSE
author:          Ivy Apps LTD
maintainer:      iliyan@ivy-apps.com
build-type:      Simple
extra-doc-files: CHANGELOG.md

common shared-properties
  default-language:   GHC2024
  ghc-options:        -Wall -Werror
  default-extensions:
    DataKinds
    DeriveAnyClass
    DeriveGeneric
    DerivingStrategies
    DuplicateRecordFields
    FlexibleContexts
    LambdaCase
    NoFieldSelectors
    OverloadedLabels
    OverloadedRecordDot
    OverloadedStrings
    TypeApplications
    TypeFamilies

  mixins:             base hiding (Prelude)
  build-depends:
    , base
    , relude

executable deslop
  import:          shared-properties
  main-is:         Main.hs
  autogen-modules: Paths_deslop
  other-modules:   Paths_deslop
  build-depends:
    , deslop
    , optparse-applicative

  hs-source-dirs:  app

  if os(linux)
    ghc-options: -optl-static -optl-pthread

library
  import:          shared-properties
  exposed-modules:
    Deslop
    Deslop.AST
    Deslop.Baseline
    Deslop.CodeGraph
    Deslop.GlobPlus
    Deslop.MCP
    Deslop.Problem
    Deslop.ProblemFormatter
    Deslop.RelativeImports
    Deslop.Rulebook
    Deslop.RuleEnforcer
    Deslop.RuleExplainer
    Effects.AI
    Effects.CLI
    Effects.FileSystem
    Effects.Git
    Effects.Licensing
    Effects.Random
    Effects.ReportProblem
    Effects.System
    Monetization.Captcha
    Monetization.CIDetection
    Params
    Prelude
    Secrets
    Types
    TypeScript.Config
    TypeScript.CST
    TypeScript.Iterator
    TypeScript.Lexer
    TypeScript.ModuleResolver
    TypeScript.Parser
    TypeScript.Tokens
    UI
    Utils

  autogen-modules: Paths_deslop
  other-modules:   Paths_deslop
  build-depends:
    , aeson
    , aeson-pretty
    , ansi-terminal
    , array
    , attoparsec
    , attoparsec-aeson
    , bytestring
    , containers
    , directory             >=1.3.8.0
    , effectful
    , effectful-core
    , exceptions
    , file-io
    , filepath              >=1.4.100.0
    , fmt
    , megaparsec
    , optparse-applicative
    , ordered-containers
    , os-string
    , process
    , random
    , regex-tdfa
    , req
    , stm
    , template-haskell
    , text
    , time
    , unix
    , unordered-containers
    , yaml

  hs-source-dirs:  src

test-suite deslop-test
  import:             shared-properties
  default-extensions:
    QuasiQuotes
    TemplateHaskell

  type:               exitcode-stdio-1.0
  hs-source-dirs:     test
  main-is:            Spec.hs
  build-tool-depends: hspec-discover:hspec-discover
  other-modules:
    Deslop.ASTSpec
    Deslop.BaselineSpec
    Deslop.CodeGraphSpec
    Deslop.GlobPlusSpec
    Deslop.ProblemFormatterSpec
    Deslop.ProblemSpec
    Deslop.RelativeImportSpec
    Deslop.RulebookSpec
    Deslop.RuleEnforcerSpec
    Doubles.CLI
    Doubles.FileSystem
    Doubles.Random
    Doubles.System
    E2E.FileGoldenSpec
    E2E.ProjectGoldenSpec
    Effects.FileSystemSpec
    Effects.RandomSpec
    Effects.ReportProblemSpec
    Monetization.CaptchaSpec
    Monetization.CIDetectionSpec
    ParamsSpec
    SecretsSpec
    TestUtils
    TypeScript.ConfigSpec
    TypeScript.IteratorSpec
    TypeScript.LexerSpec
    TypeScript.ModuleResolverSpec
    TypeScript.ParserSpec
    TypeScript.RenderableSpec
    UtilsSpec

  build-depends:
    , aeson
    , aeson-pretty
    , bytestring
    , containers
    , deslop
    , directory             >=1.3.8.0
    , effectful
    , file-io
    , filepath              >=1.4.100.0
    , hedgehog
    , hspec
    , hspec-golden
    , hspec-hedgehog
    , megaparsec
    , optparse-applicative
    , os-string
    , pretty-show
    , template-haskell
    , text
    , unliftio
    , yaml
