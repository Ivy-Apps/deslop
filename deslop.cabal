cabal-version:   3.0
name:            deslop
version:         0.10.0
license:         MIT
license-file:    LICENSE
author:          Ivy Apps LTD
maintainer:      iliyan@ivy-apps.com
build-type:      Simple
extra-doc-files: README.md

flag static
  description:
    Statically link the executable. musl only; used by the release CD.

  default:     False
  manual:      True

common shared-properties
  default-language:   GHC2024
  ghc-options:        -Wall -Werror
  default-extensions:
    DataKinds
    DeriveAnyClass
    DeriveGeneric
    DerivingStrategies
    DuplicateRecordFields
    FlexibleContexts
    LambdaCase
    NoFieldSelectors
    OverloadedLabels
    OverloadedRecordDot
    OverloadedStrings
    TypeApplications
    TypeFamilies

  mixins:             base hiding (Prelude)
  build-depends:
    , base
    , relude

executable deslop
  import:          shared-properties
  main-is:         Main.hs
  autogen-modules: Paths_deslop
  other-modules:   Paths_deslop
  build-depends:
    , deslop
    , optparse-applicative

  hs-source-dirs:  app

  -- Fully static linking only works against musl, which is what the release
  -- workflow builds in. A glibc Linux build (Nix CI, contributors on Ubuntu)
  -- cannot statically link dlopen/getauxval/pthread_*, so this is opt-in.
  if (os(linux) && flag(static))
    ghc-options: -optl-static -optl-pthread

library
  import:          shared-properties
  exposed-modules:
    Deslop
    Deslop.AST
    Deslop.Baseline
    Deslop.Casing
    Deslop.CodeGraph
    Deslop.GlobPlus
    Deslop.GlobPlus.Compiler
    Deslop.Lint.CycleDetection
    Deslop.Lint.RelativeImports
    Deslop.Problem
    Deslop.ProblemFormatter
    Deslop.ProblemShrinker
    Deslop.Rulebook
    Deslop.Rulebook.Compiler
    Deslop.Rulebook.Dto
    Deslop.Rulebook.Loader
    Deslop.RuleEnforcer
    Effects.CLI
    Effects.FileSystem
    Effects.ReportProblem
    FileSystem.Iterator
    Git.Ignore
    Params
    Prelude
    Types
    TypeScript.Config
    TypeScript.CST
    TypeScript.Iterator
    TypeScript.Lexer
    TypeScript.ModuleResolver
    TypeScript.Parser
    TypeScript.Tokens
    UI
    Utils

  autogen-modules: Paths_deslop
  other-modules:   Paths_deslop
  build-depends:
    , aeson
    , aeson-pretty
    , ansi-terminal
    , array
    , attoparsec
    , attoparsec-aeson
    , bytestring
    , containers
    , directory             >=1.3.8.0
    , effectful
    , effectful-core
    , exceptions
    , file-io
    , filepath              >=1.4.100.0
    , fmt
    , megaparsec
    , optparse-applicative
    , ordered-containers
    , os-string
    , process
    , random
    , req
    , stm
    , template-haskell
    , text
    , time
    , unix
    , unordered-containers
    , yaml

  hs-source-dirs:  src

test-suite deslop-test
  import:             shared-properties
  default-extensions:
    QuasiQuotes
    TemplateHaskell

  type:               exitcode-stdio-1.0
  hs-source-dirs:     test
  main-is:            Spec.hs
  build-tool-depends: hspec-discover:hspec-discover
  other-modules:
    Deslop.ASTSpec
    Deslop.BaselineSpec
    Deslop.CasingSpec
    Deslop.CodeGraphSpec
    Deslop.GlobPlusOracle
    Deslop.GlobPlusPropSpec
    Deslop.GlobPlusSemanticsSpec
    Deslop.GlobPlusSpec
    Deslop.Lint.CycleDetectionSpec
    Deslop.Lint.RelativeImportsSpec
    Deslop.ProblemFormatterSpec
    Deslop.ProblemShrinkerSpec
    Deslop.ProblemSpec
    Deslop.RulebookSpec
    Deslop.RuleEnforcerSpec
    Doubles.CLI
    Doubles.FileSystem
    E2E.FileGoldenSpec
    E2E.ProjectGoldenSpec
    Effects.FileSystemSpec
    Effects.ReportProblemSpec
    FileSystem.IteratorSpec
    Git.IgnoreSpec
    ParamsSpec
    TestUtils
    TypeScript.ConfigSpec
    TypeScript.IteratorSpec
    TypeScript.LexerSpec
    TypeScript.ModuleResolverSpec
    TypeScript.ParserSpec
    TypeScript.RenderableSpec
    UISpec
    UtilsSpec

  build-depends:
    , aeson
    , aeson-pretty
    , bytestring
    , containers
    , deslop
    , directory             >=1.3.8.0
    , effectful
    , file-io
    , filepath              >=1.4.100.0
    , hedgehog
    , hspec
    , hspec-golden
    , hspec-hedgehog
    , megaparsec
    , optparse-applicative
    , os-string
    , pretty-show
    , process
    , template-haskell
    , text
    , unliftio
    , yaml

-- Measures 'Deslop.doWork' over the fixture projects and gates on regression
-- against bench/reference.yaml. Local-only by design - see
-- docs/adr/0008-benchmarks-are-local-only.md.
benchmark deslop-bench
  import:         shared-properties
  type:           exitcode-stdio-1.0
  hs-source-dirs: bench
  main-is:        Main.hs
  other-modules:
    Bench.Compare
    Bench.Fixtures
    Bench.Harness
    Bench.Measurement
    Bench.Reference
    Bench.Report

  -- -O2 matches what the release CD ships, so the measurements describe the
  -- codegen users actually run. -N is pinned rather than left to the machine:
  -- a varying capability count scales wall time directly and would show up as
  -- a phantom regression. -T is what populates the memory metrics.
  ghc-options:    -O2 -threaded -rtsopts "-with-rtsopts=-N4 -T"
  build-depends:
    , aeson
    , bytestring
    , criterion
    , deslop
    , directory   >=1.3.8.0
    , effectful
    , filepath    >=1.4.100.0
    , statistics
    , text
    , time
    , vector
    , yaml
