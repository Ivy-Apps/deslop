cabal-version:   3.0
name:            deslop
version:         0.10.0
license:         MIT
license-file:    LICENSE
author:          Ivy Apps LTD
maintainer:      iliyan@ivy-apps.com
build-type:      Simple
extra-doc-files: README.md

flag static
  description:
    Statically link the executable. musl only; used by the release CD.

  default:     False
  manual:      True

common shared-properties
  default-language:   GHC2024
  ghc-options:        -Wall -Werror
  default-extensions:
    DataKinds
    DeriveAnyClass
    DeriveGeneric
    DerivingStrategies
    DuplicateRecordFields
    FlexibleContexts
    LambdaCase
    NoFieldSelectors
    OverloadedLabels
    OverloadedRecordDot
    OverloadedStrings
    TypeApplications
    TypeFamilies

  mixins:             base hiding (Prelude)
  build-depends:
    , base
    , relude

executable deslop
  import:          shared-properties
  main-is:         Main.hs
  autogen-modules: Paths_deslop
  other-modules:   Paths_deslop
  build-depends:
    , deslop
    , optparse-applicative

  hs-source-dirs:  app

  -- Fully static linking only works against musl, which is what the release
  -- workflow builds in. A glibc Linux build (Nix CI, contributors on Ubuntu)
  -- cannot statically link dlopen/getauxval/pthread_*, so this is opt-in.
  if (os(linux) && flag(static))
    ghc-options: -optl-static -optl-pthread

library
  import:          shared-properties
  exposed-modules:
    Deslop
    Deslop.AST
    Deslop.CodeGraph
    Deslop.Error
    Deslop.GlobPlus
    Deslop.GlobPlus.Casing
    Deslop.GlobPlus.Compiler
    Deslop.Problem
    Deslop.Problem.Baseline
    Deslop.Problem.Formatter
    Deslop.Problem.Shrinker
    Deslop.Rule.Book
    Deslop.Rule.Book.Compiler
    Deslop.Rule.Book.Dto
    Deslop.Rule.Book.Loader
    Deslop.Rule.Enforcer
    Deslop.Rule.Lint.CycleDetection
    Deslop.RunReport
    Effects.CLI
    Effects.FileSystem
    Effects.ReportProblem
    FileSystem.Iterator
    FileSystem.Path
    Git.Ignore
    Params
    Prelude
    Renderable
    TypeScript.AST
    TypeScript.CST
    TypeScript.Config
    TypeScript.Iterator
    TypeScript.Lexer
    TypeScript.Lint.RelativeImports
    TypeScript.ModuleResolver
    TypeScript.Parser
    TypeScript.Tokens
    UI
    Utils

  autogen-modules: Paths_deslop
  other-modules:   Paths_deslop
  build-depends:
    , aeson
    , aeson-pretty
    , ansi-terminal
    , array
    , attoparsec
    , attoparsec-aeson
    , bytestring
    , containers
    , directory             >=1.3.8.0
    , effectful
    , effectful-core
    , exceptions
    , file-io
    , filepath              >=1.4.100.0
    , fmt
    , megaparsec
    , optparse-applicative
    , ordered-containers
    , os-string
    , process
    , random
    , req
    , stm
    , template-haskell
    , text
    , time
    , unordered-containers
    , yaml

  hs-source-dirs:  src

test-suite deslop-test
  import:             shared-properties
  default-extensions:
    QuasiQuotes
    TemplateHaskell

  type:               exitcode-stdio-1.0
  hs-source-dirs:     test
  main-is:            Spec.hs
  build-tool-depends: hspec-discover:hspec-discover
  other-modules:
    Deslop.CodeGraphSpec
    Deslop.GlobPlus.CasingSpec
    Deslop.GlobPlus.Oracle
    Deslop.GlobPlusPropSpec
    Deslop.GlobPlusSemanticsSpec
    Deslop.GlobPlusSpec
    Deslop.Problem.BaselineSpec
    Deslop.Problem.FormatterSpec
    Deslop.Problem.ShrinkerSpec
    Deslop.ProblemSpec
    Deslop.Rule.Book.LoaderSpec
    Deslop.Rule.EnforcerSpec
    Deslop.Rule.Lint.CycleDetectionSpec
    Doubles.CLI
    Doubles.FileSystem
    E2E.FileGoldenSpec
    E2E.ProjectGoldenSpec
    Effects.FileSystemSpec
    Effects.ReportProblemSpec
    FileSystem.IteratorSpec
    Fixtures.Deslop.AST
    Fixtures.Deslop.Problem.Baseline
    Fixtures.TypeScript.Config
    Git.IgnoreSpec
    ParamsSpec
    TestUtils
    TypeScript.ASTSpec
    TypeScript.CSTSpec
    TypeScript.ConfigSpec
    TypeScript.IteratorSpec
    TypeScript.LexerSpec
    TypeScript.Lint.RelativeImportsSpec
    TypeScript.ModuleResolverSpec
    TypeScript.ParserSpec
    UISpec
    UtilsSpec

  build-depends:
    , aeson
    , aeson-pretty
    , bytestring
    , containers
    , deslop
    , directory             >=1.3.8.0
    , effectful
    , file-io
    , filepath              >=1.4.100.0
    , hedgehog
    , hspec
    , hspec-golden
    , hspec-hedgehog
    , megaparsec
    , optparse-applicative
    , os-string
    , pretty-show
    , process
    , template-haskell
    , text
    , unliftio
    , yaml

-- Measures 'Deslop.doWork' over the fixture projects and gates on regression
-- against bench/reference.yaml. Local-only by design - see
-- docs/adr/0008-benchmarks-are-local-only.md.
benchmark deslop-bench
  import:         shared-properties
  type:           exitcode-stdio-1.0
  hs-source-dirs: bench
  main-is:        Main.hs
  other-modules:
    Bench.Compare
    Bench.Fixtures
    Bench.Harness
    Bench.Measurement
    Bench.Reference
    Bench.Report

  -- -O2 matches what the release CD ships, so the measurements describe the
  -- codegen users actually run. -N is pinned rather than left to the machine:
  -- a varying capability count scales wall time directly and would show up as
  -- a phantom regression. -T is what populates the memory metrics.
  ghc-options:    -O2 -threaded -rtsopts "-with-rtsopts=-N4 -T"
  build-depends:
    , aeson
    , bytestring
    , criterion
    , deslop
    , directory   >=1.3.8.0
    , effectful
    , filepath    >=1.4.100.0
    , statistics
    , text
    , time
    , vector
    , yaml
