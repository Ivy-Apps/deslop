cabal-version:      3.0
name:               deslop
version:            0.4.7
license:            BSD-3-Clause
license-file:       LICENSE
author:             Ivy Apps LTD
maintainer:         iliyan@ivy-apps.com
build-type:         Simple
extra-doc-files:    CHANGELOG.md

common shared-properties
    default-language: GHC2024
    
    ghc-options: 
        -Wall 
        -Werror

    default-extensions:
        DuplicateRecordFields
        OverloadedRecordDot
        NoFieldSelectors
        OverloadedStrings
        TypeFamilies
        LambdaCase
        DataKinds
        DerivingStrategies
        DeriveAnyClass
        DeriveGeneric
        TypeApplications

library
    import:           shared-properties
    
    exposed-modules:  
        Deslop
        Params
        UI
        Types
        Deslop.RelativeImports
        TypeScript.Tokens
        TypeScript.AST
        TypeScript.Parser
        TypeScript.Lexer
        TypeScript.Config
        Translations.Parser
        Translations.Manager
        Translations.Translator
        Effects.FileSystem
        Effects.CLILog
        Effects.Git
        Effects.AI
        Effects.ReportProblem
        Utils
    autogen-modules: Paths_deslop
    other-modules: Paths_deslop

    build-depends:    
        base >= 4.18 && < 5,
        stm,
        effectful,
        effectful-core,
        aeson,
        aeson-pretty,
        attoparsec,
        attoparsec-aeson,
        text,
        bytestring,
        containers,
        unordered-containers,
        ordered-containers,
        directory,
        filepath,
        megaparsec,
        extra,
        ansi-terminal,
        time,
        process,
        req,
        fmt,
        optparse-applicative

    hs-source-dirs:   src

executable deslop
    import:           shared-properties
    main-is:          Main.hs
    autogen-modules: Paths_deslop
    other-modules: Paths_deslop
    
    build-depends:
        base,
        deslop,
        extra,
        ansi-terminal,
        optparse-applicative,
        text

    hs-source-dirs:   app

test-suite deslop-test
    import:           shared-properties
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Spec.hs
    
    build-tool-depends: hspec-discover:hspec-discover
    
    other-modules:
        TestUtils
        ParamsSpec
        DeslopSpec
        Deslop.RelativeImportSpec
        Effects.ReportProblemSpec
        TypeScript.LexerSpec
        TypeScript.ParserSpec
        TypeScript.RenderableSpec
        Translations.TranslatorSpec
        Translations.RenderableSpec
        E2E.FileGoldenSpec
        E2E.ProjectGoldenSpec
        E2E.TranslationsSpec

    build-depends:
        base,
        deslop,
        hspec,
        hspec-golden,
        text,
        effectful,
        bytestring,
        filepath,
        directory,
        unliftio,
        megaparsec,
        pretty-show,
        extra,
        QuickCheck,
        containers,
        aeson,
        aeson-pretty,
        optparse-applicative
