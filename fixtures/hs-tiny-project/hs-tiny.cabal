cabal-version: 3.0
name:          hs-tiny
version:       0.1.0

library
  hs-source-dirs:  src
  exposed-modules:
    Tiny.A
    Tiny.B
    Tiny.C
    Tiny.D
  build-depends:   base, text

executable hs-tiny
  hs-source-dirs: app shared
  main-is:        Main.hs
  other-modules:  Cli
  build-depends:  base, hs-tiny, text

executable hs-tiny-tool
  hs-source-dirs: tool shared
  main-is:        Main.hs
  other-modules:  Cli
  build-depends:  base, hs-tiny, text
