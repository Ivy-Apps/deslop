Right
  RuleBook
    { name = "Demo Rulebook"
    , rules =
        [ ForbiddenRule
            { id = RuleId "no-react-in-core"
            , description = Just "The core must not have React dependencies"
            , target =
                compile "@/client/core/**/*" :|
                  [ compile "@/server/**/*" , compile "@/shared/**/*" ]
            , exclude = Just (compile "@/**/*.e2e.spec.ts" :| [])
            , forbidden =
                [ ForbiddenImport { target = compile "react" , transitive = True }
                , ForbiddenImport
                    { target = compile "@/client/components/**/*"
                    , transitive = False
                    }
                ]
            }
        , ForbiddenRule
            { id = RuleId "no-test-code-in-impl"
            , description = Nothing
            , target = compile "**/*.ts" :| []
            , exclude = Just (compile "**/*.spec.ts" :| [])
            , forbidden =
                [ ForbiddenImport
                    { target = compile "@test/**/*" , transitive = True }
                ]
            }
        ]
    }