Right
  (Just
     RuleBook
       { name = "Client-side Rules <> Global TypeScript rules"
       , rules =
           [ ForbiddenRule
               { id = RuleId "no-react-in-core"
               , description =
                   Just "The core should be pure TypeScript. Hence, no React."
               , target = compile "@/client/core/**/*" :| []
               , exclude = Nothing
               , forbidden =
                   [ ForbiddenImport { target = compile "react" , transitive = True }
                   ]
               }
           , ForbiddenRule
               { id = RuleId "pure-design-system"
               , description = Nothing
               , target = compile "@/client/components/design-system/**/*" :| []
               , exclude = Nothing
               , forbidden =
                   [ ForbiddenImport
                       { target = compile "@/client/components/**/*" , transitive = True }
                   ]
               }
           , ForbiddenRule
               { id = RuleId "no-http-in-ui"
               , description = Nothing
               , target = compile "@/client/components/**/*" :| []
               , exclude = Nothing
               , forbidden =
                   [ ForbiddenImport
                       { target = compile "@/data/http-client" , transitive = False }
                   ]
               }
           , ForbiddenRule
               { id = RuleId "no-test-code-in-impl"
               , description = Nothing
               , target = compile "**/*.ts" :| []
               , exclude =
                   Just (compile "**/*.spec.ts" :| [ compile "**/*.test.ts" ])
               , forbidden =
                   [ ForbiddenImport
                       { target = compile "@test/**/*" , transitive = True }
                   , ForbiddenImport
                       { target = compile "@test/**/*" , transitive = True }
                   ]
               }
           ]
       })