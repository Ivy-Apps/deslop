                  "import { useState } from \"react\";\nimport { HomeUiState, HomeUiEvent } from \"@/features/home/HomeStateEvent\";\nimport { logoutUser } from \"@/features/home/data/Home-repository\";\n\nexport interface Props {\n  user: User | null;\n}\n\nexport function useHomeViewModel(props: Props) {\n  const [state, setState] = useState<HomeUiState>({ \n    user: props.user,\n    isLoading: false \n  });\n\n  const onEvent = async (event: HomeUiEvent) => {\n    switch (event.type) {\n      case \"LOGOUT_CLICKED\":\n        setState(prev => ({ ...prev, isLoading: true }));\n        // Delegate to the repository instead of using fetch()\n        await logoutUser();\n        setState({ user: null, isLoading: false });\n        break;\n    }\n  };\n\n  return { state, onEvent };\n}\n"
            , fix =
                "Extract any UI (JSX) into the View component. Remove direct `fetch` calls and replace them with function calls imported from a `-repository` file. Ensure the hook returns the current  `state` and an `onEvent` dispatcher. Do not import any Views or UI components from any directory."
            }
